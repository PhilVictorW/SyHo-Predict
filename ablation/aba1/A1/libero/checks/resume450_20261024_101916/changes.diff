+def verify_student(path, cfg, teacher, spec):
+    """Validate a model-only restart, including its completed teacher lineage."""
+    from goal_local.eval_common import model_metadata
+    from ablation.aba1.libero_common.config import FORMAT
+    path = Path(path).resolve()
+    marker = json.loads((path/'checkpoint_complete.json').read_text())
+    step = marker.get('step')
+    if ((marker.get('owner'), marker.get('stage'), marker.get('mode')) != (OWNER, 'II', 'student')
+            or type(step) is not int or not 0 < step < spec['steps'] or step % spec['save_every']
+            or path.name != f'step_{step:06d}' or not marker.get('weights_only')
+            or marker.get('optimizer_saved') is not False):
+        raise ValueError('Expected a completed intermediate Stage-II student checkpoint')
+    meta = model_metadata(path/'model.pt')
+    if (meta['format'], meta['mode'], meta['step'], meta['config']) != (FORMAT, 'student', step, cfg):
+        raise ValueError('Student configuration/step mismatch')
+    source = meta['extra'].get('teacher_source') or {}
+    if any(source.get(key) != teacher.get(key) for key in ('step', 'model_sha256')):
+        raise ValueError('Student teacher provenance mismatch')
+    if file_sha256(path/'model.pt') != marker['model_sha256']:
+        raise ValueError('Student checksum mismatch')
+    return dict(path=str(path), step=step, model_sha256=marker['model_sha256'],
+                weights_only=True, optimizer_restored=False, rng_restored=False)
+
+
+def seed_student_checkpoint(source, output):
+    """Seed a fresh run without modifying the failed run's checkpoint or logs."""
+    source = dict(source)
+    original = Path(source['path'])
+    destination = Path(output)/'checkpoints'/original.name
+    temporary = destination.with_name(destination.name+'.incomplete')
+    if destination.exists() or temporary.exists():
+        raise FileExistsError(destination)
+    def copy_file(src, dst):
+        if Path(src).name == 'model.pt':
+            os.link(src, dst)
+            return dst
+        return shutil.copy2(src, dst)
+    shutil.copytree(original, temporary, copy_function=copy_file)
+    temporary.rename(destination)
+    source.update(source_path=str(original), path=str(destination))
+    marker = json.loads((destination/'checkpoint_complete.json').read_text())
+    atomic_json(Path(output)/'latest.json', dict(marker, path=str(destination)))
+    atomic_json(Path(output)/'retention.json', dict(stage='II', steps=[source['step']], keep=1))
+    return source
+
+
+def load_student_weights(policy, source):
+    """Copy into the existing student only, before constructing its new optimizer."""
+    import torch
+    from ablation.aba1.libero_common.config import FORMAT
+    payload = torch.load(Path(source['path'])/'model.pt', map_location='cpu', mmap=True, weights_only=False)
+    if (payload['format'], payload['mode'], payload['step'], payload['config']) != (FORMAT, 'student', source['step'], policy.cfg):
+        raise ValueError('Resume payload configuration/step mismatch')
+    policy.load_state_dict(payload['state_dict'], strict=True)
+    return payload['step']
